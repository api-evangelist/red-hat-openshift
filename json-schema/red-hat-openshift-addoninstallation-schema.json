{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/AddOnInstallation",
  "title": "AddOnInstallation",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "addon": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "ready",
        "installing",
        "deleting",
        "failed"
      ]
    }
  }
}