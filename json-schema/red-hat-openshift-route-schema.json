{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Route",
  "title": "Route",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "default": "route.openshift.io/v1"
    },
    "kind": {
      "type": "string",
      "default": "Route"
    },
    "metadata": {
      "$ref": "#/components/schemas/ObjectMeta"
    },
    "spec": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "description": "Hostname for the route"
        },
        "path": {
          "type": "string"
        },
        "to": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "default": "Service"
            },
            "name": {
              "type": "string"
            },
            "weight": {
              "type": "integer"
            }
          }
        },
        "port": {
          "type": "object",
          "properties": {
            "targetPort": {
              "type": "string"
            }
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "termination": {
              "type": "string",
              "enum": [
                "edge",
                "passthrough",
                "reencrypt"
              ]
            }
          }
        }
      }
    },
    "status": {
      "type": "object"
    }
  }
}