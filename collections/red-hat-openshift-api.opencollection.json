          "http": {
            "method": "DELETE",
            "url": "https://api.{cluster}:6443/apis/route.openshift.io/v1/namespaces/:namespace/routes/:name",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
