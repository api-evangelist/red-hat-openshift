{
  "opencollection": "1.0.0",
  "info": {
    "name": "Red Hat OpenShift Container Platform Add-ons Routes API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Routes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Routes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.{cluster}:6443/apis/route.openshift.io/v1/namespaces/:namespace/routes",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Kubernetes namespace"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of resources to return"
              },
              {
                "name": "labelSelector",
                "value": "",
                "type": "query",
                "description": "Label selector to filter resources (e.g., app=myapp)"
              }
            ]
          },
          "docs": "Returns a list of Routes in the specified namespace. Routes expose services to external traffic via HTTP/HTTPS hostnames with optional TLS termination."
        },
        {
          "info": {
            "name": "Create Route",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.{cluster}:6443/apis/route.openshift.io/v1/namespaces/:namespace/routes",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Kubernetes namespace"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new Route to expose a service with an HTTP or HTTPS hostname."
        },
        {
          "info": {
            "name": "Get Route",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.{cluster}:6443/apis/route.openshift.io/v1/namespaces/:namespace/routes/:name",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Kubernetes namespace"
              },
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Resource name"
              }
            ]
          },
          "docs": "Returns the details of a specific Route."
        },
        {
          "info": {
            "name": "Update Route",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.{cluster}:6443/apis/route.openshift.io/v1/namespaces/:namespace/routes/:name",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Kubernetes namespace"
              },
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Resource name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Replaces an existing Route configuration."
        },
        {
          "info": {
            "name": "Delete Route",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.{cluster}:6443/apis/route.openshift.io/v1/namespaces/:namespace/routes/:name",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Kubernetes namespace"
              },
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Resource name"
              }
            ]
          },
          "docs": "Deletes a specific Route."
        }
      ]
    }
  ],
  "bundled": true
}